{
    "swagger": "2.0",
    "info": {
        "description": "API de microservicio para gestión de workshops",
        "title": "Workshop API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Retorna un mensaje que indica que el microservicio está en funcionamiento",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Verifica el estado del microservicio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/workshops/{id}": {
            "delete": {
                "description": "Elimina un workshop basado en su ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Workshops"
                ],
                "summary": "Elimina un workshop existente",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID del Workshop",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Workshop deleted successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Workshop not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}